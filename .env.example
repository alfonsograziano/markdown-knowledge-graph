# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- What to index ---
# The folder of markdown files. Absolute, or relative to this project folder.
SOURCE_DIR=examples/notes

# --- AWS credentials for Amazon Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials (keys that start with ASIA).
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1

# --- Models on Bedrock ---
# In many regions Claude is only offered on demand through an inference profile.
# Use the eu., us., apac. or global. prefix that matches your region.
LLM_MODEL=eu.anthropic.claude-haiku-5-5
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# --- Prices in USD per million tokens, used for the cost report ---
# Check them against the Bedrock pricing page for your region; these are estimates.
PRICE_LLM_INPUT_PER_MTOK=0.10
PRICE_LLM_OUTPUT_PER_MTOK=0.50
PRICE_EMBED_PER_MTOK=0.02

# --- Local Neo4j (Docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-something-long

# --- Graphiti ---
# A name for this graph. Use a different one per corpus to keep graphs apart in one database.
GROUP_ID=default
# How many LLM calls Graphiti runs in parallel.
SEMAPHORE_LIMIT=12
# Graphiti sends anonymous usage stats by default. Off.
GRAPHITI_TELEMETRY_ENABLED=false
